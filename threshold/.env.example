# Leaflet raster tile URL for Expo Web. The OpenStreetMap default is for development only.
# Production: owned/contracted tiles (target: PMTiles-derived tiles on Cloudflare R2).
EXPO_PUBLIC_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
EXPO_PUBLIC_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors
